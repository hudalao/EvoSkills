    \PYG{k}{if} \PYG{n}{os}\PYG{o}{.}\PYG{n}{path}\PYG{o}{.}\PYG{n}{exists}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}steam\PYGZus{}media\PYGZus{}data.csv\PYGZsq{}}\PYG{p}{):}
