\PYG{c+c1}{\PYGZsh{} Load the dataset into a pandas DataFrame}
\PYG{n}{df} \PYG{o}{=} \PYG{n}{pd}\PYG{o}{.}\PYG{n}{read\PYGZus{}csv}\PYG{p}{(}\PYG{n}{file\PYGZus{}path}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} Filter the DataFrame to keep only rows with positive values for both variables}
\PYG{c+c1}{\PYGZsh{} Using .copy() to avoid SettingWithCopyWarning}
\PYG{n}{filtered\PYGZus{}df} \PYG{o}{=} \PYG{n}{df}\PYG{p}{[(}\PYG{n}{df}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}average\PYGZus{}playtime\PYGZsq{}}\PYG{p}{]} \PYG{o}{\PYGZgt{}} \PYG{l+m+mi}{0}\PYG{p}{)} \PYG{o}{\PYGZam{}} \PYG{p}{(}\PYG{n}{df}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}positive\PYGZus{}ratings\PYGZsq{}}\PYG{p}{]} \PYG{o}{\PYGZgt{}} \PYG{l+m+mi}{0}\PYG{p}{)]}\PYG{o}{.}\PYG{n}{copy}\PYG{p}{()}

