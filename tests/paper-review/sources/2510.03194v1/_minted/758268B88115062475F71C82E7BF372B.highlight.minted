\PYG{n}{data\PYGZus{}to\PYGZus{}scale} \PYG{o}{=} \PYG{n}{filtered\PYGZus{}df}\PYG{p}{[[}\PYG{l+s+s1}{\PYGZsq{}average\PYGZus{}playtime\PYGZsq{}}\PYG{p}{,} \PYG{l+s+s1}{\PYGZsq{}positive\PYGZus{}ratings\PYGZsq{}}\PYG{p}{]]}

