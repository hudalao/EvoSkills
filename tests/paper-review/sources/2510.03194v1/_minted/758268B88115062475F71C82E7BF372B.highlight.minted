\PYG{n}{correlation}\PYG{p}{,} \PYG{n}{\PYGZus{}} \PYG{o}{=} \PYG{n}{pearsonr}\PYG{p}{(}\PYG{n}{filtered\PYGZus{}df}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}std\PYGZus{}avg\PYGZus{}playtime\PYGZsq{}}\PYG{p}{],} \PYG{n}{filtered\PYGZus{}df}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}std\PYGZus{}pos\PYGZus{}ratings\PYGZsq{}}\PYG{p}{])}

