\PYG{n}{scaled\PYGZus{}data} \PYG{o}{=} \PYG{n}{scaler}\PYG{o}{.}\PYG{n}{fit\PYGZus{}transform}\PYG{p}{(}\PYG{n}{data\PYGZus{}to\PYGZus{}scale}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} Add the new standardized columns to the filtered DataFrame}
\PYG{n}{filtered\PYGZus{}df}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}std\PYGZus{}avg\PYGZus{}playtime\PYGZsq{}}\PYG{p}{]} \PYG{o}{=} \PYG{n}{scaled\PYGZus{}data}\PYG{p}{[:,} \PYG{l+m+mi}{0}\PYG{p}{]}
